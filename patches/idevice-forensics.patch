+/// FORENSICS: short step name for an outgoing plist (its `Request` field,
+/// plus the service for StartService / the key for GetValue).
+fn fx_plist_step(message: &plist::Value) -> String {
+    let dict = message.as_dictionary();
+    let req = dict
+        .and_then(|d| d.get("Request"))
+        .and_then(|v| v.as_string())
+        .unwrap_or("PLIST");
+    let mut step = req.to_string();
+    if req == "StartService" {
+        if let Some(svc) = dict
+            .and_then(|d| d.get("Service"))
+            .and_then(|v| v.as_string())
+        {
+            step.push('/');
+            step.push_str(svc.strip_prefix("com.apple.").unwrap_or(svc));
+        }
+    } else if req == "GetValue" {
+        if let Some(key) = dict
+            .and_then(|d| d.get("Key"))
+            .and_then(|v| v.as_string())
+        {
+            step.push(':');
+            step.push_str(key);
+        }
+    }
+    if step.len() > 30 {
+        step.truncate(30);
+    }
+    step
+}
+
+/// FORENSICS: step name for a raw send; AFC packets are recognized by their
+/// `CFA6LPAA` magic and labeled with the operation number (u64 LE @ 32).
+fn fx_raw_step(bytes: &[u8]) -> String {
+    if bytes.len() >= 40 && &bytes[..8] == b"CFA6LPAA" {
+        let op = u64::from_le_bytes(bytes[32..40].try_into().unwrap());
+        format!("AFCop{op}")
+    } else {
+        "RAW".to_string()
+    }
+}
+
+/// FORENSICS: error string for the death line; socket errors keep their
+/// io kind + OS code (the plain Display would just say "device socket io
+/// failed" and hide the BrokenPipe/32 the diagnosis needs).
+fn fx_err_string(err: &IdeviceError) -> String {
+    match err {
+        IdeviceError::Socket(io) => {
+            let code = io
+                .raw_os_error()
+                .map(|c| c.to_string())
+                .unwrap_or_else(|| "?".to_string());
+            format!("Socket {:?} os{}", io.kind(), code)
+        }
+        other => other.to_string(),
+    }
+}
+
+/// FORENSICS: a connection that ends without a death line reports its
+/// totals on drop, so every begun connection leaves a complete record.
+impl Drop for Idevice {
+    fn drop(&mut self) {
+        if self.fx_open && !self.fx_dead && crate::forensics::enabled() {
+            crate::forensics::emit(&format!(
+                "C{} CLOSE sent={} recv={} life={}ms",
+                self.fx_id,
+                self.fx_sent,
+                self.fx_recv,
+                self.fx_ms()
+            ));
+        }
+    }
+}
+
