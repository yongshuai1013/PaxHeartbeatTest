+//! FORENSICS: per-connection exchange recorder (diagnostic build only).
+//!
+//! Every instrumented `Idevice` connection emits short, one-line records to a
+//! callback registered by the host app (see `ffi::forensics`). Lines look like:
+//!
+//! ```text
+//! C2 OPEN 10.7.0.1:62078
+//! C2 > QueryType 182B @3ms
+//! C2 < 96B @31ms
+//! C2 > StartService/afc 214B @40ms
+//! C2 < 128B @88ms
+//! C3 OPEN PaxHeartbeatTest-AFC
+//! C3 > AFCop7 56B @2ms
+//! C3 X >AFCop7 err=Socket BrokenPipe os32 sent=56 recv=0 life=4ms
+//! ```
+//!
+//! No callback registered = no output, near-zero cost.
+
+use std::ffi::CString;
+use std::os::raw::c_char;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+/// Line sink registered by the host app through the FFI layer.
+pub type FxCallback = extern "C" fn(*const c_char);
+
+static FX_CALLBACK: Mutex<Option<FxCallback>> = Mutex::new(None);
+static FX_NEXT_ID: AtomicU64 = AtomicU64::new(1);
+
+/// Registers (or clears, with `None`) the host app's line sink.
+pub fn set_callback(cb: Option<FxCallback>) {
+    if let Ok(mut guard) = FX_CALLBACK.lock() {
+        *guard = cb;
+    }
+}
+
+/// True once a sink is registered; lets callers skip formatting work.
+pub fn enabled() -> bool {
+    FX_CALLBACK.lock().map(|g| g.is_some()).unwrap_or(false)
+}
+
+/// Hands out the next connection number (1-based, monotonic per process).
+pub fn next_conn_id() -> u64 {
+    FX_NEXT_ID.fetch_add(1, Ordering::SeqCst)
+}
+
+/// Emits one already-formatted line to the sink, if any.
+pub fn emit(line: &str) {
+    let cb = FX_CALLBACK.lock().ok().and_then(|g| *g);
+    if let Some(cb) = cb {
+        if let Ok(cstr) = CString::new(line) {
+            cb(cstr.as_ptr());
+        }
+    }
+}
+
+/// Truncates an error string for the one-line death record.
+pub fn trunc_err(s: &str) -> String {
+    const MAX: usize = 72;
+    if s.chars().count() <= MAX {
+        s.to_string()
+    } else {
+        let mut out: String = s.chars().take(MAX).collect();
+        out.push('~');
+        out
+    }
+}
