+// FORENSICS (diagnostic build): host-app sink for the core crate's
+// per-connection exchange recorder (see `idevice::forensics`).
+
+use std::os::raw::c_char;
+
+/// Receives one forensics line (NUL-terminated, no trailing newline).
+/// The string is only valid for the duration of the call; copy it.
+/// Nullable: NULL clears the registration.
+pub type IdeviceForensicsCallback = Option<extern "C" fn(*const c_char)>;
+
+/// Registers the callback that receives forensics lines from every
+/// instrumented device connection. Pass NULL to disable.
+///
+/// # Safety
+/// `callback` must remain callable for as long as it is registered.
+#[unsafe(no_mangle)]
+pub extern "C" fn idevice_forensics_set_callback(
+    callback: IdeviceForensicsCallback,
+) {
+    idevice::forensics::set_callback(callback);
+}
